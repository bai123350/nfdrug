nextflow_process {

    name "Test Process DATAPROCESS"
    script "../main.nf"
    process "DATAPROCESS"

    // 测试标签，用于分类和过滤测试
    tag "modules"                         // 表示这是模块测试
    tag "modules_nfcore"                  // 表示这是nf-core模块
    tag "dataprocess"                   // 表示这是数据处理模块

    test("DATAPROCESS test") {

        when {
            params {
                // define parameters here. Example:
                outdir = "tests/results"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [ id:'sample1', single_end:false ],  // 元数据映射
                    ["${projectDir}/data/9606.protein.info.v11.5.txt" , // 输入文件路径
                    "${projectDir}/data/9606.protein.links.full.v11.5.txt"]  // 输入文件路径
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },                    // 验证进程是否成功完成
                { assert snapshot(process.out).match() }      // 验证输出是否与快照匹配
                //{ assert path("${process.out.structure[0][1]}").exists() }  // 验证是否创建了占位输出文件      // 验证是否创建了版本文件
            )
        }

    }

}
