{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/open-bio/molflow/master/assets/schema_input.json",
    "title": "open-bio/molflow pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "protein1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+$",
                "errorMessage": "protein1 must be provided and cannot contain spaces"
            },
            "protein2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                 "pattern": "^\\S+$",
                "errorMessage": "protein2 must be provided and cannot contain spaces"
            },
            "druggene":{
                "type": "string",
                "format": "file-path",
                "exists": true,
                 "pattern": "^\\S+$",
                "errorMessage": "druggene must be provided and cannot contain spaces"
            }

        },
        "required": ["id", "protein1"]
    }
}
